{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_PROD_SQL_SERVER;Database=QuantFlowwDb;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Redis": "YOUR_REDIS_ENDPOINT:6379"
  },
  "CorsSettings": {
    "AllowedOrigins": "https://your-production-frontend-domain.com"
  },
  "JwtSettings": {
    "Secret": "YOUR_SUPER_SECRET_KEY_FOR_JWT_SIGNING_MIN_32_BYTES_LONG",
    "Issuer": "QuantFlowwAPI",
    "Audience": "QuantFlowwClient"
  }
}
