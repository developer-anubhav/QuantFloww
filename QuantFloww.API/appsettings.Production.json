{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_PROD_POSTGRES_HOST;Database=quantfloww_db;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD",
    "Redis": "YOUR_REDIS_ENDPOINT:6379"
  },
  "CorsSettings": {
    "AllowedOrigins": "https://your-production-frontend-domain.com"
  },
  "JwtSettings": {
    "Secret": "YOUR_SUPER_SECRET_KEY_FOR_JWT_SIGNING_MIN_32_BYTES_LONG",
    "Issuer": "QuantFlowwAPI",
    "Audience": "QuantFlowwClient"
  }
}
